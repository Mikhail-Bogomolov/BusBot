BOT_TOKEN=123456:ABC...            # от @BotFather
# Прокси только для Telegram, Яндекс идёт напрямую. В Docker уже задан в docker-compose.yml (контейнер tg-proxy).
# Без Docker: socks5://127.0.0.1:<порт SOCKS из настроек Happ/v2rayN> или http://host:8888. Пусто = напрямую
TELEGRAM_PROXY=
ALLOWED_USERS=                     # Telegram id тестировщиков через запятую; пусто = все. Чужому бот пишет его id
ADMIN_ID=                          # кому слать алерты (капча, падение источника); можно пусто

# ---- Режим «остановка» (/stop): прогноз прибытия из Яндекс.Карт
STOP_SOURCE=yandex                 # yandex (HTTP, ~1 с) | yandex_browser (старый Chromium, медленно) | mock | none
STOP_INTERVAL=10                   # как часто сверять прогнозы с оповещениями, с
STOP_STALE=180                     # прогноз старше этого не используется, с
STOP_USE_SCHEDULED=0               # 1 = если нет GPS-прогноза, оповещать по расписанию
YANDEX_REFRESH=30                  # как часто обновлять прогноз по остановкам с оповещениями, с
YANDEX_PAGE_TIMEOUT=45
YANDEX_MAX_STOPS=6                 # только yandex_browser: одна вкладка Chromium на остановку
YANDEX_TZ=Asia/Krasnoyarsk
YANDEX_BLOCKED_PAUSE=900           # пауза после капчи/403, с
YANDEX_STOP_PATTERN=masstransit/getStopInfo
#YANDEX_HEADLESS=0                 # показать окно браузера (локально, для отладки)
#CHROME_PATH=                      # свой Chrome вместо встроенного в Playwright

# ---- Оповещения раньше, чем Яндекс показывает автобус (упреждение 20–40 мин)
UPSTREAM=1                         # 1 = следить за остановками выше по маршруту (только STOP_SOURCE=yandex)
YANDEX_HORIZON=15                  # на сколько минут вперёд Яндекс даёт GPS-прогноз (probe показывает текущий)
UPSTREAM_SPEED=18                  # скорость автобуса с остановками, км/ч — пока бот не выучил реальное время в пути
UPSTREAM_MAX_STOPS=4               # сколько дополнительных остановок опрашивать на одно оповещение
UPSTREAM_KGT=1                     # при SOURCE=kgt — ещё и оценка по координатам автобусов
YANDEX_LINE_TTL=86400              # схема маршрута (порядок остановок) кешируется, с

# ---- Режим «геозона» (/track): координаты автобусов
SOURCE=none                        # mock | kgt | none
POLL_INTERVAL=20
STALE_AFTER=120
DB_PATH=data/bot.sqlite3
KGT_URL=
KGT_METHOD=GET
#KGT_BODY={"route":"all"}
#KGT_HEADERS={"Referer":"https://mu-kgt.ru/"}
KGT_LIST_PATH=
KGT_F_ID=id
KGT_F_ROUTE=route
KGT_F_LAT=lat
KGT_F_LON=lon
KGT_F_HEADING=
KGT_F_SPEED=
KGT_F_TS=
KGT_COORD_SCALE=1
